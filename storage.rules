rules_version = '2';

// Storage rules for educational files.
// Files live under academies/{academyId}/resources/{resourceId}/{fileName}.
// Reads are checked against the resource's access list in Firestore
// (teacher, students and parents copied from the group when it was uploaded).
// Nothing else in Storage is readable or writable.

service firebase.storage {
  match /b/{bucket}/o {
    function isActiveAcademyUser(academyId) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.academyId == academyId
        && request.auth.token.status == 'active';
    }

    function isStaffOrOwner(academyId) {
      return isActiveAcademyUser(academyId)
        && request.auth.token.role in ['owner', 'supervisor', 'teacher'];
    }

    function canReadResource(academyId, resourceId) {
      return firestore.exists(/databases/(default)/documents/academies/$(academyId)/resources/$(resourceId))
        && (
          request.auth.token.role in ['owner', 'supervisor']
          || (
            firestore.get(/databases/(default)/documents/academies/$(academyId)/resources/$(resourceId)).data.teacherUid == request.auth.uid
          )
          || (
            firestore.get(/databases/(default)/documents/academies/$(academyId)/resources/$(resourceId)).data.studentUserIds is list
            && request.auth.uid in firestore.get(/databases/(default)/documents/academies/$(academyId)/resources/$(resourceId)).data.studentUserIds
          )
          || (
            firestore.get(/databases/(default)/documents/academies/$(academyId)/resources/$(resourceId)).data.parentUids is list
            && request.auth.uid in firestore.get(/databases/(default)/documents/academies/$(academyId)/resources/$(resourceId)).data.parentUids
          )
        );
    }

    match /academies/{academyId}/resources/{resourceId}/{fileName} {
      allow read: if isActiveAcademyUser(academyId) && canReadResource(academyId, resourceId);
      allow write: if isStaffOrOwner(academyId)
        && request.resource != null
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/.*|audio/.*|text/plain');
    }

    // Everything else is denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
